[user]
	name = Andrew Gunsch
	email = andrew@gunsch.cc
[core]
  deltaBaseCacheLimit = 1G
  autocrlf = false
  filemode = false
[push]
  default = simple
[filter "media"]
  required = true
	clean = git media clean %f
	smudge = git media smudge %f
[include]
    path = dotfiles/host/current/gitconfig

[filter "hawser"]
	clean = git hawser clean %f
	smudge = git hawser smudge %f
	required = true
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[alias]
    amend = commit --amend --reuse-message=HEAD
    new = checkout --track -b
    wipe = !git add -A && git commit -n -qm 'WIPE SAVEPOINT' && git reset HEAD~1 --hard
    files = !git diff $(git rev-parse --abbrev-ref @{u}) --name-only
	gone = "!f() {\n  git fetch -p || return\n  git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads |\n    awk '$2 == \"[gone]\" {print $1}' |\n    while read -r branch; do\n      [ -n \"$branch\" ] || continue\n      worktree_path=$(git worktree list --porcelain | awk -v want=\"refs/heads/$branch\" '\n        $1 == \"worktree\" { path = substr($0, 10) }\n        $1 == \"branch\" && $2 == want { print path }\n      ')\n      if [ -n \"$worktree_path\" ]; then\n        git worktree remove --force -- \"$worktree_path\" || continue\n      fi\n      git branch -D -- \"$branch\"\n    done\n};\nf"
[diff-so-fancy]
  stripLeadingSymbols = false
[color]
  ui = true
[color "diff-highlight"]
  oldNormal = red bold
  oldHighlight = red bold 52
  newNormal = green bold
  newHighlight = green bold 22
[color "diff"]
  meta = yellow
  frag = magenta bold
  commit = yellow bold
  old = red bold
  new = green bold
  whitespace = red reverse
[merge "ours"]
	driver = true
[safe]
	directory = /opt/plexupdate
[maintenance]
	repo = /Users/andrew.gunsch/src/devvit
[credential "https://github.snooguts.net"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[url "https://github.snooguts.net/"]
	insteadOf = git@github.snooguts.net:
